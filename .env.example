# ============================================
# Bradicoin Blockchain - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores reais:
#   cp .env.example .env
# ============================================

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Banco de Dados (MongoDB Atlas) ---
MONGO_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/bradicoin?retryWrites=true&w=majority

# --- Blockchain RPC ---
RPC_URL=https://rpc.bradicoin.com
CHAIN_ID=1337

# --- Autenticação ---
JWT_SECRET=your_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# --- Segurança (opcional, mas recomendado) ---
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- CORS (opcional) ---
CORS_ORIGIN=http://localhost:3000
