# ============================================
# Bradicoin Blockchain - Variáveis de Ambiente
# ============================================
# Copie para .env: cp .env.example .env
# ============================================

# --- Servidor ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- MongoDB Atlas ---
MONGO_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/bradicoin?retryWrites=true&w=majority

# --- Blockchain ---
RPC_URL=https://rpc.bradicoin.com
CHAIN_ID=1337
NETWORK_NAME=Bradicoin Mainnet

# ============================================
# --- Blockchain (Consenso & Mineração) ---
# ============================================
BLOCK_DIFFICULTY=3
TARGET_BLOCK_TIME_MS=30000
MAX_TX_PER_BLOCK=1000
MIN_FEE=0.001
BLOCK_REWARD=0
FEE_COLLECTOR_ADDRESS=BrSEUCOLETORDETAXAS0000000000000000000

# --- CORS ---
# Em dev use * ou http://localhost:3000
# Em produção use o domínio exato: https://bradicoin.com
CORS_ORIGIN=http://localhost:3000

# --- Autenticação ---
JWT_SECRET=your_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# --- Mineração Automática ---
AUTO_MINER_ADDRESS=BrAutoMiner
AUTO_MINER_USERNAME=AutoMiner
MINING_INTERVAL_MS=30000

# --- Distribuição de Rewards ---
REWARD_INTERVAL_MS=3600000

# --- Validators ---
MIN_VALIDATOR_STAKE=1000
