# ============================================
# Bradicoin Blockchain - .env (LOCAL)
# ============================================
# ⚠️ Este arquivo NÃO vai pro Git
# ============================================

# --- Servidor ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- MongoDB Atlas ---
# ⚠️ Cole aqui a string com a SENHA NOVA que você acabou de gerar
MONGO_URI=mongodb+srv://bicoin10_db_user:SENHA_NOVA_AQUI@bradicoin.25onboo.mongodb.net/bradicoin?retryWrites=true&w=majority

# --- Blockchain ---
RPC_URL=https://rpc.bradicoin.com
CHAIN_ID=1337
NETWORK_NAME=Bradicoin Mainnet
INITIAL_BALANCE=1000

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- Autenticação ---
# Gere uma chave forte com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=COLE_AQUI_UMA_CHAVE_ALEATORIA_LONGA
JWT_EXPIRES_IN=7d

# --- Mineração Automática ---
AUTO_MINER_ADDRESS=BrAutoMiner
AUTO_MINER_USERNAME=AutoMiner
MINING_INTERVAL_MS=30000

# --- Distribuição de Rewards ---
REWARD_INTERVAL_MS=3600000

# --- Staking ---
STAKING_APY=18
STAKE_POOL_ADDRESS=BrSTAKEPOOL000000000000000000000000000000

# --- Validators ---
MIN_VALIDATOR_STAKE=1000
