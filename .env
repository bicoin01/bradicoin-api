# ============================================
# BRADICOIN - PRODUCTION CONFIGURATION
# ============================================

# ===== SERVIDOR =====
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ===== RPC E REDE =====
# URL pública da sua API (para validação externa)
RPC_URL=https://seu-dominio.com
RPC_HOST=0.0.0.0
RPC_PORT=8545
# Número único da sua cadeia (não use 1337 em produção, escolha um entre 1 e 2^32-1)
CHAIN_ID=1337

# ===== BLOCKCHAIN =====
BRADICOIN_DATA_DIR=./bradicoin-data
COIN_NAME=Bradicoin
COIN_SYMBOL=BRD
DECIMALS=18
TOTAL_SUPPLY=21000000
BLOCK_TIME=10
NETWORK=mainnet

# ===== SEGURANÇA (CRÍTICO) =====
# Gere um valor aleatório de 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=coloque_aqui_um_hash_gerado_pelo_comando_acima

# Chave para criptografia adicional (opcional, mas recomendado)
ENCRYPTION_KEY=coloque_outro_hash_de_32_bytes

# Chave de API para serviços externos (se usar)
API_KEY=seu_api_key_se_tiver

# ===== BANCO DE DADOS (OPCIONAL) =====
# Se quiser usar MongoDB ou Redis, descomente e configure:
# MONGODB_URI=mongodb://localhost:27017/bradicoin
# REDIS_URL=redis://localhost:6379

# ===== SERVIÇOS EXTERNOS (OPCIONAL) =====
# INFURA_KEY=...
# ETHERSCAN_KEY=...
