# ============================================
# Bradicoin Blockchain - .env (LOCAL / DEVELOPMENT)
# ============================================
# ⚠️ Este arquivo NÃO vai pro Git
# ============================================

# --- Servidor ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- MongoDB Atlas ---
MONGO_URI==mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/bradicoin?retryWrites=true&w=majority

# --- Blockchain (Rede) ---
RPC_URL=https://rpc.bradicoin.com
CHAIN_ID=1337
NETWORK_NAME=Bradicoin Mainnet

# ============================================
# --- Blockchain (Consenso & Mineração) ---
# ============================================
BLOCK_DIFFICULTY=3
TARGET_BLOCK_TIME_MS=30000
MAX_TX_PER_BLOCK=1000
MIN_FEE=0.001
BLOCK_REWARD=0
FEE_COLLECTOR_ADDRESS=BrA1B2C3D4E5F6A7B8C9D0E1F2A3B4C5D6E7F8

# ============================================
# --- Fundo de Reserva ---
# ============================================
RESERVE_ADDRESS=Br1F2E3D4C5B6A79887766554433221100FFEEDD
MAX_SUPPLY=1000000000
RESERVE_INITIAL_BALANCE=0

# ============================================
# --- Wallet ---
# ============================================
INITIAL_BALANCE=1000

# ============================================
# --- Domínio & CORS ---
# ============================================
DOMAIN=localhost
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Autenticação ---
JWT_SECRET=9blh5gm3kUUakshoTYZNG59DhW+JFfO38anAD9i+91c=
JWT_EXPIRES_IN=7d

# --- Mineração Automática ---
AUTO_MINER_ADDRESS=Br9876543210ABCDEF0123456789ABCDEF012345
AUTO_MINER_USERNAME=AutoMiner
MINING_INTERVAL_MS=30000

# --- Distribuição de Rewards ---
REWARD_INTERVAL_MS=3600000

# --- Validators ---
MIN_VALIDATOR_STAKE=1000

# ============================================
# --- Modo de Operação ---
# ============================================
OPERATION_MODE=personal
STAKING_MODE=lab
BETA_WARNING=false
